# docs/intent/concurrency.config — how parallel work is coordinated
CONCURRENCY_MODE=detect        # off | detect | reserve   (detect = advisory, no failure modes)
LOCK_TTL_HOURS=24              # leases expire; stale locks are reclaimable by anyone
LOCK_SCOPE=claims,plan_files   # [DECLARED — nothing reads this; the scope is whatever intent_lock.py does]
WORKTREE_AUTO=true             # a git worktree per change
WORKTREE_ROOT=..               # where worktrees are created
REGISTER_FRAGMENTS=true   # [DECLARED — nothing reads this; fragment assembly is a convention]
