# docs/intent/provenance.config — hard rules for AI-generated contributions
AGENT_MARKERS=CLAUDE_CODE_CHILD_SESSION,INTENT_AGENT_ID   # env vars that mark an agent session
ALLOW_CLAUDECODE_FALLBACK=false   # true only on Claude Code < 2.1.172; also fires in IDE terminals
REQUIRE_ASSISTED_BY=true          # H1: every agent commit carries Assisted-by
FORBID_AGENT_SIGNOFF=true         # H5: agents never add Signed-off-by
GENERATED_SHARE_REVIEW=70         # [SKILL-READ — no script reads this] intent-merge-gate is instructed
                                  # to force HUMAN-REVIEW at or above this % generated
SPDX_REQUIRED=auto                # [DECLARED — nothing checks this] licence-header intention only
