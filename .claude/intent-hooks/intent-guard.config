# intent-flow enforcement config (sourced by the guard scripts)
SPEC_PATHS="openspec/ docs/specs/"
REGISTER="docs/intent/INTENT_REGISTER.md"
TRACE="docs/intent/INTENT_TRACE.yaml"
ENFORCE_LEVEL="block"       # block | warn — block is the default on purpose.
                            # warn is for initial calibration ONLY; guards count ignored
                            # warnings and session status will nag until flipped back.
TRACE_REQUIRED="false"      # set true once INTENT_TRACE.yaml exists; enforced LOCALLY and in CI
